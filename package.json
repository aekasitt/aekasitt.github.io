{
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "serve": "^14.2.6",
    "tailwindcss": "^4.2.2"
  },
  "name": "aekasitt-github-io",
  "packageManager": "yarn@6.0.0-rc.19",
  "scripts": {
